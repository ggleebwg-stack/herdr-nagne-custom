{
  "global": {
    "ctrl-shift-j": {
      "command": "pane.split",
      "args": { "direction": "right", "mod": "skills" }
    },
    "ctrl-shift-h": {
      "command": "tab.new",
      "args": { "name": "History", "mod": "history" }
    },
    "ctrl-shift-u": {
      "command": "mod.open",
      "args": { "name": "providers" }
    },
    "ctrl-shift-y": {
      "command": "mod.open",
      "args": { "name": "scrollback" }
    }
  },
  "layout:supervisor": {
    "ctrl-shift-a": "layout.toggle:watch"
  }
}
